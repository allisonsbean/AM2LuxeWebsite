<div class="am2r">
  <div class="am2r__wrap">
    <span class="am2r__eyebrow">What our clients say</span>
    <div class="am2r__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
    <blockquote class="am2r__quote">My girls and I love doing our nails together. They wear them for school, take them off for a game, then set them right back on after.</blockquote>
    <div class="am2r__who">Lucinda &middot; Verified buyer</div>
    <span class="am2r__rule"></span>
  </div>
</div>
<style>
  .am2r{--foil:linear-gradient(135deg,#8A6D2F,#D9BC75,#F4E7B8,#B8923F,#F0DB96,#9C7B3B,#D4B76A);background:#F5F1E8}
  .am2r__wrap{max-width:860px;margin:0 auto;padding:100px 34px;text-align:center}
  .am2r__eyebrow{font-family:'Jost',sans-serif;font-size:11px;letter-spacing:.34em;text-transform:uppercase;background:var(--foil);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent}
  .am2r__stars{background:var(--foil);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent;letter-spacing:.3em;font-size:18px;margin:22px 0 26px}
  .am2r__quote{font-family:'Bodoni Moda',serif;font-style:italic;font-weight:400;font-size:34px;line-height:1.4;color:#161311;margin:0;letter-spacing:.005em}
  .am2r__who{font-family:'Jost',sans-serif;font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:#5B5349;margin-top:30px}
  .am2r__rule{display:block;width:52px;height:2px;background:var(--foil);margin:34px auto 0}
  @media(max-width:700px){.am2r__wrap{padding:72px 24px}.am2r__quote{font-size:25px}}
</style>
{% schema %}
{ "name": "AM2 Reviews", "tag": "section", "settings": [], "presets": [{ "name": "AM2 Reviews" }] }
{% endschema %}
