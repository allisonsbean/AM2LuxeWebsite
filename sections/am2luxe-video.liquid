<div class="am2v">
  <div class="am2v__wrap">
    <span class="am2v__rule"></span>
    <span class="am2v__eyebrow">See them in motion</span>
    <h2 class="am2v__title">Salon-worthy, up close</h2>
    <div class="am2v__frame">
      <video
        src="https://cdn.shopify.com/videos/c/o/v/7d79b56e585646909c079f6f81ec1bf8.mp4"
        autoplay muted loop playsinline preload="metadata"></video>
    </div>
    <a href="/collections/all" class="am2v__btn">Shop the collection</a>
  </div>
</div>
<style>
  .am2v{--foil:linear-gradient(135deg,#8A6D2F,#D9BC75,#F4E7B8,#B8923F,#F0DB96,#9C7B3B,#D4B76A);background:#161311;color:#F5F1E8}
  .am2v__wrap{max-width:1000px;margin:0 auto;padding:88px 34px;text-align:center}
  .am2v__rule{display:block;width:56px;height:2px;background:var(--foil);margin:0 auto 22px}
  .am2v__eyebrow{font-family:'Jost',sans-serif;font-size:11px;letter-spacing:.36em;text-transform:uppercase;background:var(--foil);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent}
  .am2v__title{font-family:'Bodoni Moda',serif;font-weight:500;font-size:42px;color:#F5F1E8;margin:14px 0 34px}
  .am2v__frame{background:var(--foil);padding:3px;display:inline-block;line-height:0;box-shadow:0 30px 70px -30px rgba(0,0,0,.7)}
  .am2v video{display:block;max-width:100%;max-height:78vh;width:auto;height:auto;background:#0d0b0a}
  .am2v__btn{display:inline-block;margin-top:36px;background:var(--foil);color:#161311;font-family:'Jost',sans-serif;font-size:11.5px;letter-spacing:.22em;text-transform:uppercase;font-weight:500;padding:16px 36px;text-decoration:none;transition:filter .2s ease}
  .am2v__btn:hover{filter:brightness(1.08)}
  @media(max-width:700px){.am2v__wrap{padding:64px 24px}.am2v__title{font-size:32px}.am2v video{max-height:70vh}}
</style>
{% schema %}
{ "name": "AM2 Video", "tag": "section", "settings": [], "presets": [{ "name": "AM2 Video" }] }
{% endschema %}
