<div class="am2h">
  <div class="am2h__glow"></div>
  <div class="am2h__wrap">
    <span class="am2h__rule"></span>
    <span class="am2h__eyebrow">Reusable press-on manicures</span>
    <h1 class="am2h__title">The salon,<br>without the <em>appointment</em>.</h1>
    <p class="am2h__lede">Luxury soft-gel nails applied in minutes and worn again and again. Two ways to wear, sixteen sizes for a flawless fit, and a fraction of the salon price.</p>
    <div class="am2h__cta">
      <a href="/collections/all" class="am2h__btn am2h__btn--gold">Shop the collection</a>
      <a href="#shopify-section-am2luxe_how" class="am2h__btn am2h__btn--line">How it works</a>
    </div>
    <div class="am2h__value">$16 a set &mdash; a fraction of a <span>$45+</span> salon visit</div>
    <div class="am2h__meta">
      <span>Wear up to two weeks</span>
      <span>Reusable</span>
      <span>32 nails, 16 sizes</span>
    </div>
  </div>
</div>
<style>
  .am2h{--foil:linear-gradient(135deg,#8A6D2F 0%,#D9BC75 18%,#F4E7B8 34%,#B8923F 50%,#F0DB96 66%,#9C7B3B 84%,#D4B76A 100%);position:relative;background:#161311;overflow:hidden}
  .am2h__glow{position:absolute;inset:0;background:radial-gradient(60% 55% at 50% 32%,rgba(196,169,104,.20) 0%,rgba(196,169,104,.06) 40%,transparent 72%);pointer-events:none}
  .am2h__wrap{position:relative;max-width:900px;margin:0 auto;padding:120px 34px 116px;text-align:center;animation:am2hUp 1s cubic-bezier(.16,1,.3,1) both}
  @keyframes am2hUp{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
  .am2h__rule{display:block;width:60px;height:2px;background:var(--foil);margin:0 auto 26px}
  .am2h__eyebrow{font-family:'Jost',sans-serif;font-size:11px;letter-spacing:.4em;text-transform:uppercase;background:var(--foil);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent}
  .am2h__title{font-family:'Bodoni Moda',serif;font-weight:500;font-size:86px;line-height:1.02;color:#F7F3EA;margin:22px 0 26px;letter-spacing:.005em}
  .am2h__title em{font-style:italic;background:var(--foil);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent}
  .am2h__lede{font-family:'Jost',sans-serif;font-weight:300;font-size:17px;line-height:1.8;color:rgba(247,243,234,.72);max-width:520px;margin:0 auto}
  .am2h__cta{display:flex;gap:16px;justify-content:center;margin-top:38px;flex-wrap:wrap}
  .am2h__btn{font-family:'Jost',sans-serif;font-size:11.5px;letter-spacing:.22em;text-transform:uppercase;font-weight:500;padding:17px 36px;text-decoration:none;transition:all .25s ease;display:inline-block}
  .am2h__btn--gold{background:var(--foil);color:#161311}
  .am2h__btn--gold:hover{filter:brightness(1.08)}
  .am2h__btn--line{background:transparent;color:#F7F3EA;border:1px solid rgba(247,243,234,.5)}
  .am2h__btn--line:hover{background:#F7F3EA;color:#161311;border-color:#F7F3EA}
  .am2h__value{font-family:'Bodoni Moda',serif;font-style:italic;font-size:18px;color:rgba(247,243,234,.8);margin-top:32px}
  .am2h__value span{background:var(--foil);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent;font-style:normal}
  .am2h__meta{display:flex;gap:30px;justify-content:center;margin-top:26px;font-family:'Jost',sans-serif;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:rgba(247,243,234,.6);flex-wrap:wrap}
  .am2h__meta span{position:relative;padding-left:16px}
  .am2h__meta span::before{content:"";position:absolute;left:0;top:4px;width:6px;height:6px;background:var(--foil);transform:rotate(45deg)}
  @media(max-width:700px){.am2h__wrap{padding:84px 24px 78px}.am2h__title{font-size:52px}.am2h__meta{gap:18px}}
</style>
{% schema %}
{ "name": "AM2 Hero", "tag": "section", "settings": [], "presets": [{ "name": "AM2 Hero" }] }
{% endschema %}
