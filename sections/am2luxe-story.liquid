<div class="am2s">
  <div class="am2s__wrap">
    <div class="am2s__media"><div class="am2s__frame"><img src="https://am2luxe.com/cdn/shop/files/IMG_8695.jpg?v=1754705828&width=1000" alt="AM2Luxe"></div></div>
    <div class="am2s__copy">
      <span class="am2s__rule"></span>
      <span class="am2s__eyebrow">Made for real life</span>
      <h2 class="am2s__title">Beautiful nails that keep up with you</h2>
      <p>AM2Luxe began at our own kitchen table, doing our nails together between practices, games, and everything else a full week holds.</p>
      <p>We wanted salon-quality nails that fit real life: quick to apply, gentle to take on and off for game day, and priced so the whole family can play. That is what every set is built to be.</p>
      <a href="/pages/about" class="am2s__btn"><span>Read our story</span></a>
    </div>
  </div>
</div>
<style>
  .am2s{--foil:linear-gradient(135deg,#8A6D2F,#D9BC75,#F4E7B8,#B8923F,#F0DB96,#9C7B3B,#D4B76A);background:#F5F1E8}
  .am2s__wrap{max-width:1180px;margin:0 auto;padding:96px 34px;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:66px}
  .am2s__frame{background:var(--foil);padding:3px;box-shadow:0 30px 70px -34px rgba(22,19,17,.5)}
  .am2s__frame img{width:100%;aspect-ratio:4/5;object-fit:cover;display:block}
  .am2s__rule{display:block;width:52px;height:2px;background:var(--foil);margin-bottom:20px}
  .am2s__eyebrow{font-family:'Jost',sans-serif;font-size:11px;letter-spacing:.34em;text-transform:uppercase;background:var(--foil);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent}
  .am2s__title{font-family:'Bodoni Moda',serif;font-weight:500;font-size:44px;line-height:1.1;color:#161311;margin:16px 0 22px}
  .am2s__copy p{font-family:'Jost',sans-serif;font-weight:300;font-size:16px;line-height:1.85;color:#5B5349;max-width:490px;margin:0 0 16px}
  .am2s__btn{display:inline-block;background:var(--foil);padding:1.5px;margin-top:12px;text-decoration:none}
  .am2s__btn span{display:block;background:#F5F1E8;color:#161311;font-family:'Jost',sans-serif;font-size:11.5px;letter-spacing:.2em;text-transform:uppercase;font-weight:500;padding:15.5px 32px;transition:all .25s ease}
  .am2s__btn:hover span{background:transparent}
  @media(max-width:820px){.am2s__wrap{grid-template-columns:1fr;gap:40px}.am2s__media{max-width:420px}.am2s__title{font-size:34px}}
</style>
{% schema %}
{ "name": "AM2 Story", "tag": "section", "settings": [], "presets": [{ "name": "AM2 Story" }] }
{% endschema %}
